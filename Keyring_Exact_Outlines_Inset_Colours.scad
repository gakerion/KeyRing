// Exact original main.stl plus customizable raised text.
// Original outline coordinates and heights are preserved exactly.
// Planar surfaces are retriangulated by OpenSCAD; no contour simplification.
// Self-contained: no other files required.
/* [Name] */
Name = "ALEX";
// Font size in mm; reduce this if the name extends beyond the plate.
Text_size = 8; // [2:0.5:14]
// Choose a font and style installed in the online customizer.
Font = "Arial:style=Bold"; // font
// 1 is normal character spacing.
Letter_spacing = 1; // [0.6:0.05:1.5]
// Raised text height in mm; original default is 0.5 mm.
Text_height = 0.5; // [0.2:0.1:1.5]
/* [Text placement] */
// Horizontal adjustment from the original text centre, in mm.
Text_offset_x = 0; // [-15:0.5:15]
// Vertical adjustment from the original text centre, in mm.
Text_offset_y = 0; // [-5:0.5:5]
Text_rotation = 0; // [-15:1:15]
// 100 preserves letter proportions. Reduce to narrow a long name.
Text_width_percent = 100; // [40:1:150]
/* [Colours] */
// Colour of the full backing plate.
Base_colour = "#FFFFFF"; // color
// Colour of the raised character, cap, border and legs.
Artwork_colour = "#EF5350"; // color
// Keep the name the same colour as the raised artwork for two-colour printing.
Match_name_to_artwork = true;
// Used when Match name to artwork is switched off.
Name_colour = "#EF5350"; // color
/* [Inset colours] */
// Match the base, use one shared inset colour, or choose three individual colours.
Inset_colour_mode = "Match base"; // [Match base, One shared colour, Separate colours]
Shared_inset_colour = "#FFFFFF"; // color
Face_colour = "#FFFFFF"; // color
Nameplate_background_colour = "#FFFFFF"; // color
Lower_panel_colour = "#FFFFFF"; // color
/* [Hidden] */
verification_part = "all";
module custom_name() {
    translate([75.587723475*0.733/2+Text_offset_x,
               19.4018*0.733/2+Text_offset_y,0])
        rotate([0,0,Text_rotation])
            scale([Text_width_percent/100,1,1])
                linear_extrude(height=Text_height)
                    text(Name,size=Text_size,spacing=Letter_spacing,
                         halign="center",valign="center",font=Font);
}
// No geometry cutting: add text directly to the original base.
if (verification_part=="base") original_base();
else if (verification_part=="text") color(Match_name_to_artwork ? Artwork_colour : Name_colour) custom_name();
else {
    backing_with_insets();
    color(Artwork_colour) raised_artwork();
    color(Match_name_to_artwork ? Artwork_colour : Name_colour) custom_name();
}

// Inset colours occupy the existing top 0.2 mm of the base; no added height.
inset_skin = 0.2;
function inset_colour(c) = Inset_colour_mode == "One shared colour" ? Shared_inset_colour : c;
module original_base() {
    backing_with_insets();
    color(Artwork_colour) raised_artwork();
}
module backing_plate() {
    translate([0,0,-2.1989998817443848])
        linear_extrude(height=2.1989998817443848,convexity=20) original_outline();
}
module backing_with_insets() {
    if (Inset_colour_mode == "Match base") color(Base_colour) backing_plate();
    else {
        color(Base_colour) {
            translate([0,0,-2.1989998817443848])
                linear_extrude(height=2.1989998817443848-inset_skin,convexity=20) original_outline();
            translate([0,0,-inset_skin])
                linear_extrude(height=inset_skin,convexity=20)
                    polygon(points=concat(base_points,art_points),
                        paths=concat(base_paths,[for(i=[4,1,3,5,6])
                            [for(j=art_paths[i]) j+len(base_points)]]),convexity=20);
        }
        color(inset_colour(Face_colour))
            translate([0,0,-inset_skin]) linear_extrude(height=inset_skin,convexity=20)
                polygon(points=art_points,paths=[art_paths[4],art_paths[1],art_paths[3]],convexity=20);
        color(inset_colour(Nameplate_background_colour))
            translate([0,0,-inset_skin]) linear_extrude(height=inset_skin,convexity=20)
                polygon(points=art_points,paths=[art_paths[5]],convexity=20);
        color(inset_colour(Lower_panel_colour))
            translate([0,0,-inset_skin]) linear_extrude(height=inset_skin,convexity=20)
                polygon(points=art_points,paths=[art_paths[6]],convexity=20);
    }
}
module raised_artwork() {
    linear_extrude(height=0.36649999022483826,convexity=20) artwork_outline();
}
module original_outline() { polygon(points=base_points,paths=base_paths,convexity=20); }
module artwork_outline() { polygon(points=art_points,paths=art_paths,convexity=20); }
